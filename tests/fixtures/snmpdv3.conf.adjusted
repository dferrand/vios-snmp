# Expected output for the synthetic configuration with community CHANGEME.

VACM_GROUP sampleReaders SNMPv1 CHANGEME -
VACM_VIEW sampleView internet - included -
VACM_VIEW sampleView system - included -
VACM_VIEW sampleView snmpModules - included -
VACM_VIEW sampleView 1.3.6.1.4.1.2.6.191 - included -
VACM_ACCESS sampleReaders - - noAuthNoPriv SNMPv1 sampleView - - -

NOTIFY sampleNotify sampleTag trap -
TARGET_ADDRESS sampleSink UDP 192.0.2.45 sampleTag sampleParams - - -
TARGET_PARAMETERS sampleParams SNMPv1 SNMPv1 public noAuthNoPriv -

COMMUNITY CHANGEME CHANGEME noAuthNoPriv 0.0.0.0 0.0.0.0 -
DEFAULT_SECURITY no-access - -
